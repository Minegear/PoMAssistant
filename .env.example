# Modèle de configuration : copiez ce fichier en `.env` puis remplissez les valeurs.
#   cp .env.example .env        (Windows PowerShell : Copy-Item .env.example .env)
#
# `.env` contient VOS valeurs et n'est jamais versionné (il est dans .gitignore).
# `.env.example` ne contient aucune vraie valeur : il sert juste à dire quelles
# variables l'application attend.

# Supabase > Project Settings > API > "Project URL"
VITE_SUPABASE_URL=

# Supabase > Project Settings > API > clé "anon" / "public" UNIQUEMENT.
# Ne mettez jamais la clé "service_role" ici : les variables VITE_* sont embarquées
# dans le JavaScript envoyé au navigateur, donc visibles par tous les visiteurs.
VITE_SUPABASE_ANON_KEY=
